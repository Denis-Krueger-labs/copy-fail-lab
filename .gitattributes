# Generated kernel type header.
**/vmlinux.h linguist-generated

# Compiled eBPF object files.
**/*.bpf.o linguist-generated

# Preserved compiled MORI binaries.
**/mori_observer linguist-generated
**/mori_splice_probe linguist-generated
**/mori_observer.v2.7 linguist-generated
